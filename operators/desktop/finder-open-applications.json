{
  "name": "finder-open-applications",
  "steps": [
    { "kind": "switch-app", "app": "Finder" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "focus-window", "app": "Finder" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "hotkey", "keys": "cmd,shift,a" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "image", "mode": "screen", "path": "/tmp/clawcore-finder-applications-screen.png" }
  ]
}
