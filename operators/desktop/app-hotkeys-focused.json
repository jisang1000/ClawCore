{
  "name": "app-hotkeys-focused",
  "steps": [
    { "kind": "launch-app", "app": "Safari" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "switch-app", "app": "Safari" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "hotkey", "keys": "cmd,t" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "hotkey", "keys": "cmd,w" },
    { "kind": "sleep", "seconds": 1 },
    { "kind": "see", "annotate": true, "path": "/tmp/clawcore-app-hotkeys-focused-see.png" }
  ]
}
